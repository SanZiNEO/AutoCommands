{
  "bindings": {
    "demo": {
      "triggerMode": "sequential",
      "commands": [
        {
          "rawCommand": "/say 收到信号：%message%",
          "delay": 0,
          "randomDelay": 0
        },
        {
          "rawCommand": "/effect give @a speed 10 1 && /say 效果已应用",
          "delay": 10,
          "randomDelay": 5
        }
      ],
      "key": "key.keyboard.g"
    },
    "welcome": {
      "triggerMode": "sequential",
      "commands": [
        {
          "rawCommand": "/say 欢迎 %username%！",
          "delay": 0,
          "randomDelay": 0
        }
      ],
      "key": null
    },
    "random_effect": {
      "triggerMode": "random",
      "commands": [
        {
          "rawCommand": "/effect give @a speed 10 2",
          "delay": 0,
          "randomDelay": 0
        },
        {
          "rawCommand": "/effect give @a jump_boost 10 2",
          "delay": 0,
          "randomDelay": 0
        }
      ],
      "key": "key.mouse.1"
    }
  },
  "variables": {
    "server_name": "AutoCommands 服务器"
  },
  "server": {
    "port": 8888
  }
}
